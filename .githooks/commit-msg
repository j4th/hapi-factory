#!/usr/bin/env bash
# hapi-factory's commit-msg hook (Task 7b Step 5, H-057): the commit message
# holds none of the operator's personal strings (private/personal-strings.txt,
# .githooks/lib.sh), since messages are published with the history. It names
# the line, never the string. Skipped with a notice in a clone without
# private/. git passes the message's file as $1.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
# shellcheck source=.githooks/lib.sh
. "$root/.githooks/lib.sh"

patterns="$(personal_patterns)"
if [[ -z "$patterns" ]]; then
  skip_notice
  exit 0
fi
trap 'rm -f "$patterns"' EXIT

# Every line down to git's own cut block: a scissors line, then "# Do not modify or
# remove the line above.". git writes the two when `commit -v` puts the diff below
# them, and removes everything from there. A scissors line alone is checked like any
# other, and so is what follows it: git cuts there only with -v or --cleanup=scissors,
# and `commit -m` or -F keeps it. "#" lines count too: git strips them only when it
# cleans up an edited message, and `commit -m` keeps them.
hits="$(awk -v cut="# ------------------------ >8 ------------------------" '
    held && $0 == "# Do not modify or remove the line above." { held = 0; exit }
    held { print cut; held = 0 }
    $0 == cut { held = 1; next }
    { print }
    END { if (held) print cut }' "$1" | grep -n -F -i -w -f "$patterns" | cut -d: -f1 || true)"
if [[ -n "$hits" ]]; then
  echo "commit-msg: the commit message holds a personal string from $PERSONAL_STRINGS, on line $(echo "$hits" | paste -sd, -)." >&2
  echo "Replace it (\"the operator\", \$OWNER or <owner>) and commit again; your message is in .git/COMMIT_EDITMSG." >&2
  exit 1
fi
