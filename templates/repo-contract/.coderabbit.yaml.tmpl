# yaml-language-server: $schema=https://coderabbit.ai/integrations/schema.v2.json
#
# CodeRabbit's config for {{name}}, from hapi-factory's repo contract: a
# second-vendor reviewer, advisory only. It adds to the factory's in-run
# review, CI and the maintainer's merge and never replaces them: never a merge
# authority, never a required check.
#
# Review-only. Every way CodeRabbit can write to the repo is off here:
# approvals, the finishing touches (Fix comments, docstrings, unit tests,
# simplify, fix-CI, merge conflicts), labels, reviewer assignment, chat
# auto-replies and issue features. Its tools stay on as a second opinion
# beside CI.
#
# CodeRabbit reviews a same-repo PR with that PR branch's own copy of this
# file, so a PR could weaken its own review: this file is a protected path.
# It is hapi-factory's own .coderabbit.yaml without hapi's path instructions
# and code guidelines.
language: en-US
early_access: false
tone_instructions: "Be terse and technical. Lead with the security or correctness impact, then the fix. No praise, no restating the diff, no style nits a linter would catch. If unsure, say nothing."
reviews:
  profile: chill
  auto_approvals:
    enabled: false
    allow_author_approval: false
  high_level_summary: true
  high_level_summary_in_walkthrough: true
  poem: false
  in_progress_fortune: false
  review_status: true
  review_details: false
  sequence_diagrams: false
  suggested_reviewers: false
  auto_assign_reviewers: false
  auto_apply_labels: false
  enable_prompt_for_ai_agents: true
  fail_commit_status: false
  path_filters:
    - "!build/**"
  auto_review:
    enabled: true
    drafts: false
    auto_incremental_review: true
    auto_pause_after_reviewed_commits: 2
    ignore_title_keywords: ["WIP", "[skip review]"]
  slop_detection:
    enabled: true
    include_all_authors: false
  finishing_touches:
    docstrings: { enabled: false }
    unit_tests: { enabled: false }
    simplify: { enabled: false }
    autofix: { enabled: false }
    fix_ci: { enabled: false }
    resolve_merge_conflict: { enabled: false }
  pre_merge_checks:
    override_requested_reviewers_only: true
    docstrings: { mode: "off" }
    title:
      { mode: warning, requirements: "Conventional Commits: type(scope): imperative summary, under 72 characters." }
    description: { mode: warning }
    issue_assessment: { mode: warning }
    custom_checks:
      - name: "Protected paths declared"
        mode: warning
        instructions: "Fail if the PR changes a protected path (an agent instruction file: AGENTS.md, AGENTS.override.md, AGENT.md, CLAUDE.md, CLAUDE.local.md, GEMINI.md, HERMES.md, .hermes.md, SOUL.md, REVIEW.md, .cursorrules, .windsurfrules, or anything under .claude/, .hermes/, .cursor/, .clinerules/ or .rules/, at any depth; or .factory/**, .github/**, .pi/**, .agents/**, .archon/**, .coderabbit.yaml, .coderabbit.yml, .coderabbit.config.ts; or, at any depth, a mise config, lockfile or task directory (mise.toml, mise.lock, mise.*.lock, .mise.toml, mise.local.toml, .mise.local.toml, mise.*.toml, .mise.*.toml, .config/mise.toml, .config/mise.*.toml, .tool-versions, or anything under mise/, .mise/, .config/mise/, mise-tasks/ or .mise-tasks/), anything under .git/, .gitleaks.toml, .gitleaksignore, the MCP configs .mcp.json and .vscode/mcp.json, or .gitattributes; every name in any case; or the gates' own config, at any depth: biome.json*, bunfig.toml, tsconfig*.json, osv-scanner.toml), and its description has no section titled 'Protected-path change' saying why. Pass otherwise."
  tools:
    gitleaks: { enabled: true }
    osvScanner: { enabled: true }
    zizmor: { enabled: true }
    actionlint: { enabled: true }
    shellcheck: { enabled: true }
    hadolint: { enabled: true }
    yamllint: { enabled: true }
    opengrep: { enabled: true }
    languagetool: { enabled: false }
chat:
  auto_reply: false
  # Applies only to organization repos.
  allow_non_org_members: false
knowledge_base:
  opt_out: false
  web_search: { enabled: true }
  # Learnings from chat wait 30 days for review, since on a public repo anyone can chat.
  learnings: { scope: local, approval_delay: 30 }
  issues: { scope: local }
  pull_requests: { scope: local }
  mcp: { usage: disabled }
  automatic_linking_mode: disabled
issue_enrichment:
  auto_enrich: { enabled: false }
  planning:
    auto_planning: { enabled: false }
