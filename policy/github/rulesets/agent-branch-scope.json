{
  "name": "agent-branch-scope",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": {
    "include": ["~ALL"],
    "exclude": ["~DEFAULT_BRANCH", "refs/heads/plan/**", "refs/heads/factory/**"] } },
  "bypass_actors": [
    { "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }
  ],
  "rules": [ { "type": "creation" }, { "type": "update" }, { "type": "deletion" } ]
}
